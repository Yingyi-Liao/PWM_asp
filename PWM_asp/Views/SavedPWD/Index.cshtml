@model IEnumerable<PWM_asp.Models.SavedPWD>

@{
    ViewData["Title"] = "Saved Passwords";
}

<h2>Saved Passwords</h2>

<p>
    <a asp-controller="SavedPWD" asp-action="Create" class="btn btn-success">
        Add New Password
    </a>

</p>

<form method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control"
               placeholder="Search passwords...">
        <button type="submit" class="btn btn-primary">Search</button>
        <a href="@Url.Action("Index")" class="btn btn-secondary">Clear</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Account</th>
            <th>Source</th>
            <th>Description</th>
            <th>Created At</th>
            <th>Updated At</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Account</td>
                <td>@item.Source?.SourceName</td>
                <td>@item.Description</td>
                <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@item.UpdatedAt?.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.SavedPWDId" class="btn btn-sm btn-primary">Details</a>
                    <a asp-action="Edit" asp-route-id="@item.SavedPWDId" class="btn btn-sm btn-warning">Edit</a>
                    <button type="button" class="btn btn-sm btn-secondary" onclick="copyPwd(@item.SavedPWDId)">Copy</button>
                    <a asp-action="Delete" asp-route-id="@item.SavedPWDId" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>


<script>
    async function copyPwd(id) {
        try {
            const response = await fetch('/SavedPWD/RevealAjax/' + id, {
                method: 'POST'
            });

            if (!response.ok) {
                alert("Unable to reveal password");
                return;
            }

            const data = await response.json();
            await navigator.clipboard.writeText(data.password);

            showToast("Password copied");
        }
        catch (err) {
            console.error(err);
            alert("Error copying password");
        }
    }

    function showToast(message) {
        const toast = document.createElement("div");
        toast.className = "toast-message";
        toast.innerText = message;
        document.body.appendChild(toast);

        setTimeout(() => toast.remove(), 2000);
    }
</script>

<style>
    .toast-message {
        position: fixed;
        bottom: 20px;
        right: 20px;
        background: #333;
        color: #fff;
        padding: 10px 18px;
        border-radius: 6px;
        opacity: 0.9;
        z-index: 9999;
    }

    .toast-message.success {
        background-color: #28a745;
    }

    .toast-message.error {
        background-color: #dc3545;
    }

    .toast-message.fade-out {
        opacity: 0;
    }
</style>