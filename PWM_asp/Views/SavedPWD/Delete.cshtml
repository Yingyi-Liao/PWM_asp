@model PWM_asp.Models.SavedPWD

@{
    ViewData["Title"] = "Delete Password";
}

<h2>Delete Password</h2>

<div class="alert alert-danger">
    Are you sure you want to delete this password?
</div>

<dl class="row">
    <dt class="col-sm-3">Account</dt>
    <dd class="col-sm-9">@Model.Account</dd>

    <dt class="col-sm-3">Source</dt>
    <dd class="col-sm-9">@Model.Source?.SourceName</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.Description</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="SavedPWDId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
