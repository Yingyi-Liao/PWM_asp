@model IEnumerable<PWM_asp.Models.ArchivedPWD>

@{
    ViewData["Title"] = "Archived Passwords";
}

<h2>Archived Passwords</h2>

<form method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control"
               placeholder="Search passwords...">
        <button type="submit" class="btn btn-primary">Search</button>
        <a href="@Url.Action("Index")" class="btn btn-secondary">Clear</a>
    </div>
</form>


<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Account</th>
            <th>Source</th>
            <th>Description</th>
            <th>Archived At</th>
            <th>Archived By</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Account</td>
                <td>@item.Source?.SourceName</td>
                <td>@item.Description</td>
                <td>@item.ArchivedAt.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@item.ArchivedBy</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.ArchivedPWDId" class="btn btn-sm btn-primary">
                        Details
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
